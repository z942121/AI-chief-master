# ===== 大模型 =====
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=

# ===== Embedding 模型 =====
EMBEDDING_MODEL=text-embedding-v2
DASHSCOPE_EMBEDDING_URL=

# ===== 联网搜索 =====
TAVILY_API_KEY=

# ===== 阿里云 OSS =====
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_ENDPOINT=

# ===== LangSmith 追踪（可选）=====
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=

# ===== RAG 配置 =====
# 相似度阈值（0~1，越大越严格）
# 2026-09-14 Ablation 实验后由 0.50 调整为 0.35
RAG_SCORE_THRESHOLD=0.35

# RAG Rerank 权重（语义 + 食材匹配，和约为 1.0）
RAG_SEMANTIC_WEIGHT=0.4
RAG_INGREDIENT_WEIGHT=0.6

# Hybrid Retrieval RRF 权重
RRF_FINAL_WEIGHT=0.5
RRF_INGREDIENT_WEIGHT=0.5

# ===== MySQL 数据库 =====
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
